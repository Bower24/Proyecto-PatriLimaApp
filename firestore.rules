rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Función para verificar si el usuario es un administrador formal
    // Requiere: estar autenticado, tener correo verificado y existir en la colección /administradores
    function esAdmin() {
      return request.auth != null &&
             request.auth.token.email_verified == true &&
             exists(/databases/$(database)/documents/administradores/$(request.auth.uid));
    }

    // 2. Reglas para la colección 'reportes'
    match /reportes/{idReporte} {

      // LECTURA: Cualquier usuario autenticado (ciudadano o admin) puede ver los reportes
      allow read: if request.auth != null;

      // CREACIÓN: Cualquier ciudadano (o admin) puede crear un nuevo reporte siempre que:
      // - Esté autenticado.
      // - El 'idUsuario' coincida con su UID autenticado.
      // - El estado inicial sea estrictamente 'ENVIADO'.
      // - Contenga los campos mínimos obligatorios.
      allow create: if request.auth != null &&
                       request.resource.data.idUsuario == request.auth.uid &&
                       request.resource.data.estado == 'ENVIADO' &&
                       request.resource.data.severidad in ['LEVE', 'MODERADO', 'SEVERO'] &&
                       request.resource.data.direccion is string &&
                       request.resource.data.descripcion is string;

      // ACTUALIZACIÓN:
      // Caso A: Un Administrador verificado puede cambiar el estado (a 'EN_REVISION' o 'REVISADO')
      // Caso B: El sistema/ciudadano actualiza únicamente el contador 'likes_count'

      allow update: if esAdmin() ||
                      (request.auth != null &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes_count']));

      // ELIMINACIÓN: Solo un Administrador verificado puede borrar un reporte
      allow delete: if esAdmin();

      // 3. Subcolección de LIKES por usuario (Unicidad y voto ciudadano)
      match /likes/{idUsuario} {
        allow read: if request.auth != null;
        // Un ciudadano solo puede crear o borrar el documento si su UID coincide con el ID del documento
        allow write: if request.auth != null && request.auth.uid == idUsuario;
      }
    }

    // 4. Catálogo de Bienes Patrimoniales (Solo lectura pública)
    match /bienes_patrimoniales/{idBien} {
      allow read: if request.auth != null;
      allow write: if esAdmin();
    }

    // 5. Colección de Administradores (Solo lectura institucional, no modificable desde la app móvil)
    match /administradores/{idAdmin} {
      allow read: if request.auth != null;
      allow write: if false; // Solo el dueño del proyecto puede crear admins en Firebase Console
    }
  }
}